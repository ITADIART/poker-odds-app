<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/felt_deep"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:background="#000000">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <it.pokerodds.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#99000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/ink"
            android:textSize="11sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/vWord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:text="—"
                    android:textColor="@color/ink"
                    android:textSize="46sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/vWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inquadra il tavolo: le tue carte sotto la linea gialla, le carte comuni sopra."
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/panel"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                style="@style/Label"
                android:text="TAVOLO" />

            <LinearLayout
                android:id="@+id/boardChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                style="@style/Label"
                android:text="LE TUE CARTE" />

            <LinearLayout
                android:id="@+id/heroChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="AVVERSARI" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/panel2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/oppMinus"
                            style="@style/StepButton"
                            android:text="−" />

                        <TextView
                            android:id="@+id/oppText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/ink"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/oppPlus"
                            style="@style/StepButton"
                            android:text="+" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="PIATTO" />

                    <EditText
                        android:id="@+id/pot"
                        style="@style/NumField"
                        android:text="100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="DA CHIAMARE" />

                    <EditText
                        android:id="@+id/call"
                        style="@style/NumField"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Piatto = tutte le fiches al centro, compresa la puntata da chiamare."
                android:textColor="@color/ink_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/lockBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Blocca carte" />

                <Button
                    android:id="@+id/newHandBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Nuova mano" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tocca una carta per correggerla. Trascina la linea gialla sulla fotocamera per separare le tue carte dal tavolo. Il consiglio guarda solo le probabilità (avversari con carte a caso), non posizione, stack o stile di gioco.\n\nSolo per allenarsi nelle partite di prova: nelle partite vere usare un aiuto durante la mano è vietato."
                android:textColor="@color/ink_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
